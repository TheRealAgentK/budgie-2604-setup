#!/bin/bash
# Recover Budgie's swayidle when it stops handling suspend.
#
# Budgie's swayidle (started by budgie-daemon) holds a logind "delay" sleep
# inhibitor and runs "before-sleep swaylock ..." when logind announces a
# suspend, then releases the inhibitor. Occasionally it stops reacting to
# logind's PrepareForSleep signal while keeping the inhibitor. Every suspend
# after that waits the full 30 s InhibitDelayMaxSec and then goes ahead
# WITHOUT locking the screen, and logind logs:
#
#   Delay lock is active (UID 1000/kai, PID 4740/swayidle) but inhibitor timeout is reached.
#
# The root cause is fixed by swayidle-dbus-fix; this is the safety net.
#
# This follows logind's journal for that line. When the PID named is one of
# this user's swayidle processes, it:
#   1. runs its before-sleep command (the lock screen), if it has one and that
#      is not already running
#   2. restarts it: the resume-display-on listener is only killed (its loop
#      respawns it); any other is started again with the same arguments
#
# Started from the labwc autostart (swayidle-lock-guard block). Exits when the
# Wayland session it was started in goes away.
#
#   swayidle-lock-guard           follow the journal (normal use)
#   swayidle-lock-guard --stdin   read log lines from stdin instead (testing);
#                                 set SWAYIDLE_LOCK_GUARD_DRYRUN=1 to only print
set -u

TAG=swayidle-lock-guard
DRYRUN=${SWAYIDLE_LOCK_GUARD_DRYRUN:-0}
RE='^Delay lock is active \(UID [0-9]+/[^,]*, PID ([0-9]+)/swayidle\) but inhibitor timeout is reached'

log() {
    if [ "$DRYRUN" = 1 ]; then printf '%s: %s\n' "$TAG" "$*" >&2
    else printf '%s\n' "$*" | systemd-cat -t "$TAG"; fi
}

run() {
    if [ "$DRYRUN" = 1 ]; then
        local -a shown=("$@")
        if [ "${shown[0]}" = env ]; then   # don't print the whole environment
            shown=("${shown[@]:1}"); [ "${shown[0]}" = -i ] && shown=("${shown[@]:1}")
            while [[ ${shown[0]} == *=* ]]; do shown=("${shown[@]:1}"); done
            shown=("env -i <budgie-daemon env>" "${shown[@]}")
        fi
        log "would run: ${shown[*]}"
    else
        "$@" 9>&-
    fi
}

recover() {
    local pid=$1 i lockcmd="" lockbin parent src
    local -a argv envv

    [ -r "/proc/$pid/cmdline" ] || { log "swayidle $pid already gone"; return; }
    [ "$(stat -c %u "/proc/$pid")" = "$(id -u)" ] || return
    mapfile -d '' argv < "/proc/$pid/cmdline"
    [ "${argv[0]##*/}" = swayidle ] || return
    # The relaunch uses budgie-daemon's environment (it is what normally starts
    # Budgie's swayidle), falling back to the old process's own. Never the caller's:
    # a terminal's PATH (e.g. miniconda's dbus-send first) breaks the commands
    # swayidle runs.
    src=$(pgrep -u "$(id -u)" -x budgie-daemon | head -1)
    mapfile -d '' envv < "/proc/${src:-$pid}/environ" 2>/dev/null \
        || mapfile -d '' envv < "/proc/$pid/environ"
    for ((i = 1; i < ${#argv[@]}; i++)); do
        [ "${argv[i]}" = before-sleep ] && lockcmd=${argv[i + 1]-}
    done
    parent=$(tr '\0' ' ' < "/proc/$(ps -o ppid= -p "$pid" | tr -d ' ')/cmdline" 2>/dev/null)

    log "swayidle $pid ignored the suspend (inhibitor timeout); recovering it"

    # 1. lock now if this is the instance that locks (Budgie's) - the system
    #    is about to suspend without a lock screen
    if [ -n "$lockcmd" ]; then
        lockbin=${lockcmd%% *}
        if pgrep -u "$(id -u)" -x "${lockbin##*/}" >/dev/null; then
            log "${lockbin##*/} already running"
        else
            run env -i "${envv[@]}" setsid -f sh -c 'exec "$@" </dev/null >/dev/null 2>&1' _ sh -c "$lockcmd"
        fi
    fi

    # 2. restart it. The resume-display-on loop respawns its own listener, so
    #    that one is only killed; anything else is started again with the same
    #    arguments.
    run kill "$pid"
    case "$parent" in
        *resume-display-on-listener*) log "killed; resume-display-on respawns it"; return ;;
    esac
    for ((i = 0; i < 20; i++)); do
        [ "$DRYRUN" = 1 ] || kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    run env -i "${envv[@]}" setsid -f sh -c 'exec "$@" </dev/null 2>&1 | systemd-cat -t budgie-swayidle' _ "${argv[@]}"
    log "swayidle restarted"
}

handle_line() {
    [[ $1 =~ $RE ]] && recover "${BASH_REMATCH[1]}"
}

if [ "${1-}" = --stdin ]; then
    while IFS= read -r line; do handle_line "$line"; done
    exit 0
fi

sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-wayland-0}"

# One guard per session.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/$TAG.lock"
flock -n 9 || exit 0

log "watching logind for stuck swayidle (session $sock)"
while [ -S "$sock" ]; do
    coproc JF { exec journalctl --follow --lines=0 --output=cat -t systemd-logind 9>&- 2>/dev/null; }
    while [ -S "$sock" ]; do
        IFS= read -r -t 60 line <&"${JF[0]}"
        rc=$?
        if [ "$rc" = 0 ]; then handle_line "$line"
        elif [ "$rc" -gt 128 ]; then continue   # timeout: re-check the session
        else break; fi                          # journalctl exited: restart it
    done
    kill "$JF_PID" 2>/dev/null
    wait "$JF_PID" 2>/dev/null
    [ -S "$sock" ] && sleep 5
done
log "Wayland session gone; exiting"
